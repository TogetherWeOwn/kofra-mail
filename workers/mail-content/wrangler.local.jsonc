{
  // Local emulation only. Account RPC is supplied by the test fixture.
  "name": "mail-content-local",
  "main": "src/entry.ts",
  "compatibility_date": "2026-07-30",
  "compatibility_flags": ["enable_request_signal"],
  "workers_dev": false,
  "preview_urls": false,
  "observability": { "logs": { "invocation_logs": false } },
  "services": [
    { "binding": "MAIL_LOOKUP", "service": "mail-backend-local", "entrypoint": "ContentLookup" },
    { "binding": "ACCOUNT_EPOCH", "service": "account-local", "entrypoint": "CredentialEpoch" }
  ],
  // File links (M3-13): the IP-keyed flood bucket that runs before any lookup on /f/.
  "ratelimits": [
    { "name": "LINK_FLOOD", "namespace_id": "2001", "simple": { "limit": 120, "period": 60 } }
  ],
  "vars": {
    "MAIL_CONTENT_ENABLED": "off",
    "CONTENT_ORIGIN": "https://content.example",
    "MAIL_APP_ORIGIN": "https://mail.example",
    "CONTENT_ZONE": "content.example",
    "CONTENT_SUITE_DOMAIN": "mail.example",
    "CONTENT_STORAGE_DOMAIN": "objects.example",
    "CONTENT_ACCOUNT_DOMAIN": "account.example",
    "CONTENT_WORKERS_DEV_DOMAIN": "account-example.workers.dev",
    "LINK_HOSTS": "files.example",
    "LINK_REFUSED_ZONES": "[\"mail.example\", \"content.example\", \"files.example\", \"objects.example\", \"account.example\"]"
  }
}
