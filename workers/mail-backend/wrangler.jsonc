{
  // Production template. Replace the directory ID and resource names per environment.
  "name": "mail-backend",
  "main": "src/entry.ts",
  "compatibility_date": "2025-06-01",
  "workers_dev": false,
  "preview_urls": false,
  "vars": {
    "MAIL_BACKEND_ENABLED": "off",
    "MAIL_CONTENT_ENABLED": "off",
    "MAIL_RECOVERY_ENABLED": "off",
    "MAIL_SWEEP_ENABLED": "off",
    "MAIL_SEND_ENABLED": "off",
    "MAIL_ENVIRONMENT": "production",
    "DELIVERY_QUEUE_NAME": "mail-deliver",
    "DEAD_LETTER_QUEUE_NAME": "mail-deliver-dlq"
  },
  "d1_databases": [{
    "binding": "DIRECTORY",
    "database_name": "mail-directory",
    "database_id": "00000000-0000-0000-0000-000000000000"
  }],
  "r2_buckets": [{ "binding": "MAIL_STATE", "bucket_name": "mail-state" }],
  "services": [{ "binding": "ALERTS", "service": "mail-alerts" }],
  "durable_objects": { "bindings": [
    { "name": "MAILBOX", "class_name": "Mailbox" },
    { "name": "SWEEPER", "class_name": "Sweeper" },
    { "name": "SEND_QUOTA", "class_name": "SendQuota" }
  ] },
  "migrations": [
    { "tag": "v1", "new_sqlite_classes": ["Mailbox", "Sweeper"] },
    { "tag": "send-quota-v1", "new_sqlite_classes": ["SendQuota"] }
  ],
  "queues": {
    "producers": [
      { "binding": "DELIVER", "queue": "mail-deliver" },
      { "binding": "SEND", "queue": "send" }
    ],
    "consumers": [
      { "queue": "mail-deliver", "max_batch_size": 1, "max_retries": 3, "dead_letter_queue": "mail-deliver-dlq" },
      { "queue": "mail-deliver-dlq", "max_batch_size": 10, "retry_delay": 300, "max_retries": 10 }
    ]
  },
  "triggers": { "crons": ["* * * * *"] }
}
